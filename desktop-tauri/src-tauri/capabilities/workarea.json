{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "workarea",
  "description": "Ажлын муж — алсын Web origin-оос ирсэн хуудас. Зөвхөн гэрээний гүүр.",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://localhost:3000",
      "http://localhost:3000/*",
      "http://127.0.0.1:3000",
      "http://127.0.0.1:3000/*"
    ]
  },
  "permissions": [
    "allow-workarea-bridge"
  ]
}
