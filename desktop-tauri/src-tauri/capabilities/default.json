{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Бүрхүүлийн цонхнуудад хэрэгтэй хамгийн бага эрхүүд.",
  "windows": ["main", "login", "offline", "prefs"],
  "remote": {
    "urls": [
      "http://localhost:3000",
      "http://localhost:3000/*",
      "http://127.0.0.1:3000",
      "http://127.0.0.1:3000/*"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "core:webview:allow-webview-close",
    "deep-link:default"
  ]
}
