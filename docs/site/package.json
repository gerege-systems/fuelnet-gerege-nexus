{
  "name": "open-gerege-nexus-docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Static site generator for the Gerege Nexus documentation published to GitHub Pages.",
  "scripts": {
    "build": "node build.mjs",
    "check": "node build.mjs && node check-links.mjs",
    "serve": "node --run build && node -e \"import('node:http').then(({default:h})=>import('node:fs').then(({default:f})=>h.createServer((q,s)=>{const p='dist'+(q.url==='/'?'/index.html':q.url.split('?')[0]);f.readFile(p,(e,d)=>e?(s.statusCode=404,s.end('not found')):s.end(d))}).listen(4321,()=>console.log('http://localhost:4321'))))\""
  },
  "dependencies": {
    "marked": "18.0.9"
  }
}
