<Window x:Class="GeregeNexusNativeWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Open Gerege Nexus Native (Windows C#)"
        Height="820" Width="1280"
        MinHeight="680" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F17">
    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0: Native Windows Top Menu Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Embedded WebView2 Container -->
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Native Menu Bar -->
        <Menu Grid.Row="0" Background="#111827" Foreground="#F3F4F6" Height="30">
            <MenuItem Header="Gerege Nexus" Foreground="#F3F4F6" Padding="10,4">
                <MenuItem Header="Gerege Nexus-ийн тухай" Click="MenuAbout_Click"/>
                <Separator/>
                <!-- "…цонх" гэсэн нэр байхаа больсон: эдгээр нь тусдаа цонх БИШ,
                     аппын ижил хүрээн дотор солигдох дэлгэцүүд. -->
                <MenuItem Header="Түгжих / дахин нэвтрэх" Click="MenuLogin_Click" InputGestureText="Ctrl+L"/>
                <MenuItem Header="Тохиргоо" Click="MenuSettings_Click" InputGestureText="Ctrl+,"/>
                <Separator/>
                <MenuItem Header="Гарах" Click="MenuExit_Click" InputGestureText="Alt+F4"/>
            </MenuItem>

            <MenuItem Header="Удирдах" Foreground="#F3F4F6" Padding="10,4">
                <MenuItem Header="Ажлын муж" Click="NavWork_Click" InputGestureText="Ctrl+0"/>
                <MenuItem Header="Шугамын нүүр" Click="MenuLineHome_Click" InputGestureText="Ctrl+H"/>
                <MenuItem Header="Апп дэлгүүр (/apps)" Click="MenuApps_Click" InputGestureText="Ctrl+1"/>
                <MenuItem Header="Дахин ачаалах" Click="MenuReload_Click" InputGestureText="F5"/>
            </MenuItem>

            <MenuItem Header="Харах" Foreground="#F3F4F6" Padding="10,4">
                <MenuItem Header="Бүтэн дэлгэцээр харах" Click="MenuFullScreen_Click" InputGestureText="F11"/>
            </MenuItem>
        </Menu>

        <!--
            Аппын биет: зүүн талд native rail, баруун талд солигддог дэлгэц.

            Rail нь тенантын апп цэс БИШ — түүнийг ажлын муж өөрөө зурдаг.
            Энд зөвхөн бүрхүүлийн эзэмшдэг дэлгэцүүд байна, ингэснээр нэг цэс
            хоёр газар, хоёр өөр төлөвтэй болохгүй.
        -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Name="navRail" Grid.Column="0" Width="168" Background="#0D121B" BorderBrush="#1B2432" BorderThickness="0,0,1,0" Visibility="Collapsed">
                <StackPanel Margin="10,14">
                    <Button Name="navWorkButton" Content="▦   Ажлын муж" Click="NavWork_Click" HorizontalContentAlignment="Left" Padding="10,7" Margin="0,0,0,2" Background="Transparent" BorderThickness="0" Foreground="#62D9D4"/>
                    <Button Name="navSettingsButton" Content="⚙   Тохиргоо" Click="NavSettings_Click" HorizontalContentAlignment="Left" Padding="10,7" Background="Transparent" BorderThickness="0" Foreground="#B8C1CE"/>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1">
                <wv2:WebView2 Name="webView" Visibility="Collapsed"/>
                <ContentControl Name="settingsHost" Visibility="Collapsed"/>
            </Grid>

            <!-- Нэвтрэлт нь мөн энэ хүрээний дэлгэц: rail-ыг оруулаад бүтнээр
                 нь бүрхэнэ. Тусдаа нэвтрэх цонх нээгдэхгүй. -->
            <Border Name="loginView" Grid.Column="0" Grid.ColumnSpan="2" Background="#0B0F17">
                <StackPanel Width="390" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Gerege Nexus" Foreground="#F3F4F6" FontSize="32" FontWeight="Bold"/>
                    <TextBlock Text="Тавтай морил — native нэвтрэлт" Foreground="#9CA3AF" Margin="0,4,0,24"/>
                    <TextBox Name="emailInput" Height="40" Margin="0,0,0,10" ToolTip="И-мэйл"/>
                    <PasswordBox Name="passwordInput" Height="40" Margin="0,0,0,10" ToolTip="Нууц үг"/>
                    <Button Name="passwordLoginButton" Height="42" Content="Нэвтрэх" Click="PasswordLogin_Click"/>
                    <Separator Margin="0,22"/>
                    <TextBox Name="nationalIdInput" Height="40" Margin="0,0,0,10" ToolTip="Регистрийн дугаар"/>
                    <Button Name="pushLoginButton" Height="42" Content="eID апп руу хүсэлт илгээх" Click="PushLogin_Click"/>
                    <Button Name="qrLoginButton" Height="38" Margin="0,8,0,0" Content="eID QR харуулах" Click="QrLogin_Click"/>
                    <Image Name="qrImage" Width="180" Height="180" Margin="0,12,0,0" Visibility="Collapsed"/>
                    <StackPanel Name="staffPinPanel" Visibility="Collapsed"><Separator Margin="0,22"/><TextBlock Text="Ажилтны хурдан нэвтрэлт" Foreground="#F3F4F6" FontWeight="SemiBold" Margin="0,0,0,8"/><PasswordBox Name="staffPinInput" Height="40" Margin="0,0,0,10" ToolTip="4–12 оронтой PIN"/><Button Name="staffPinButton" Height="42" Content="Ээлжийн ажилтнаар нэвтрэх" Click="StaffPin_Click"/></StackPanel>
                    <TextBlock Name="loginStatus" Foreground="#D1D5DB" TextWrapping="Wrap" Margin="0,16,0,8"/>
                    <Button Name="cancelLoginButton" Height="36" Content="Цуцлах" Click="CancelLogin_Click" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Name="nativeFooter" Grid.Row="2" Height="30" Background="#101620" BorderBrush="#263244" BorderThickness="0,1,0,0" Visibility="Collapsed">
            <Grid Margin="12,0">
                <!-- Тохиргооны товч энэ мөрөөс хасагдсан: түүнийг зүүн талын
                     rail эзэмшинэ. Нэг үйлдэл хоёр газар байвал аль нь идэвхтэй
                     гэдгийг харуулах төлөв хоёр тийш хуваагдана. -->
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Name="footerConnection" Text="●  Холбогдож байна" Foreground="#62D9D4" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Name="footerPlatform" Grid.Column="2" Text="Windows · Desktop  |  Shell v1.4" Foreground="#9CA3AF" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
