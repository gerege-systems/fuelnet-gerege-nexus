<Application x:Class="GeregeNexusNativeWin.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Native Dark Theme Tokens -->
        <SolidColorBrush x:Key="WindowBackground" Color="#0B0F17" />
        <SolidColorBrush x:Key="MenuBackground" Color="#111827" />
        <SolidColorBrush x:Key="MenuForeground" Color="#F3F4F6" />
    </Application.Resources>
</Application>
