# ppt.nexus.gerege.mn — static presentation site.
# Drop into /etc/nginx/sites-available/, symlink to sites-enabled, reload.
server {
    listen 443 ssl http2;
    server_name ppt.nexus.gerege.mn;

    # Reuse the certificate setup used by the other nexus subdomains.
    ssl_certificate     /etc/letsencrypt/live/nexus.gerege.mn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/nexus.gerege.mn/privkey.pem;

    root /var/www/nexus-ppt;
    index index.html;

    add_header X-Content-Type-Options nosniff;
    add_header X-Frame-Options DENY;

    location / {
        try_files $uri $uri/ /index.html;
        # Single self-contained file; allow revalidation on each deploy.
        add_header Cache-Control "public, max-age=300, must-revalidate";
    }
}

server {
    listen 80;
    server_name ppt.nexus.gerege.mn;
    return 301 https://$host$request_uri;
}
