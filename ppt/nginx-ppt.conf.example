# ppt.nexus.gerege.mn — статик танилцуулга (нэг бие даасан index.html).
#
# Энэ хостын конвенц: дэд домэйн бүр өөрийн certbot гэрчилгээтэй (wildcard биш).
# Тиймээс энд ЗӨВХӨН 80 портын блокийг бичнэ — TLS-ийн мөрүүдийг certbot өөрөө
# нэмнэ. Суулгах дараалал:
#
#   sudo install -m 0644 ppt.nexus.gerege.mn.conf \
#        /etc/nginx/sites-available/ppt.nexus.gerege.mn
#   sudo ln -sfn /etc/nginx/sites-available/ppt.nexus.gerege.mn \
#                /etc/nginx/sites-enabled/ppt.nexus.gerege.mn
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d ppt.nexus.gerege.mn --redirect
#
# certbot дараа нь 443 блок үүсгэж, 80-г 301 болгож өөрчилнө — js.nexus,
# cp.nexus зэрэгтэй яг ижил хэлбэр гарна.

server {
    listen 80;
    server_name ppt.nexus.gerege.mn;

    location /.well-known/acme-challenge/ { root /var/www/html; }

    root /var/www/nexus-ppt;
    index index.html;

    add_header X-Content-Type-Options nosniff;
    add_header X-Frame-Options DENY;

    location / {
        try_files $uri $uri/ /index.html;
        # Нэг файлтай тул deploy бүрт дахин шалгуулна.
        add_header Cache-Control "public, max-age=300, must-revalidate";
    }
}
