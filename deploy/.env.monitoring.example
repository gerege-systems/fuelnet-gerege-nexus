# Environment for deploy/docker-compose.monitoring.yml.
#
# Copy to /opt/open-gerege-nexus/.env.monitoring on the server and fill in the
# two required values. Never commit the real file — it carries the Grafana
# administrator password, the monitoring database password and, if e-mail is
# configured, an SMTP credential.
#
#   docker compose -f deploy/docker-compose.monitoring.yml \
#     --env-file .env.monitoring up -d
#
# The platform stack has its own .env and is unaffected by anything here.

# ---------------------------------------------------------------- required

# Grafana's administrator. There is no default on purpose: a Grafana on
# admin/admin behind a public nginx is somebody else's infrastructure on
# display. Generate with: openssl rand -base64 24
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# The password for the `monitoring` database role. Migration 00044 creates the
# role with pg_monitor and no password; set the same value here and on the role
# itself, once:
#
#   docker exec -i gerege_nexus_postgres psql -U postgres -d platform_db \
#     -c "ALTER ROLE monitoring WITH PASSWORD 'the value below'"
#
# The role can read pg_stat_* and nothing else — no table, no tenant row.
MONITORING_DB_PASSWORD=

# ---------------------------------------------------------------- optional

# Named on every alert, so a message at 03:00 says which deployment before
# anything has to be opened. Set it when more than one instance reports to the
# same inbox.
DEPLOYMENT_NAME=fuelnet

# Where Alertmanager is reached from a browser, and the fallback Grafana uses
# when GRAFANA_ROOT_URL below is not set.
MONITORING_PUBLIC_URL=https://fuelnet.gerege.mn

# Where Grafana is reached from a browser, and whether it lives at the root of
# that address or under a path. The nginx side has to match:
#
#   a host of its own          nginx/monitor.fuelnet.gerege.mn.conf
#     GRAFANA_ROOT_URL=https://monitor.fuelnet.gerege.mn
#     GRAFANA_SUBPATH=false
#
#   a path on the platform     nginx/snippets/nexus-monitoring.conf
#     GRAFANA_ROOT_URL=https://fuelnet.gerege.mn/grafana
#     GRAFANA_SUBPATH=true
#
# Get the pair wrong and every page loads while every link points nowhere.
# Changing GRAFANA_SUBPATH also moves Grafana's own /metrics — see the grafana
# job in monitoring/prometheus/prometheus.yml, which cannot read this file.
GRAFANA_ROOT_URL=https://monitor.fuelnet.gerege.mn
GRAFANA_SUBPATH=false

# The platform stack's Docker network, which this stack joins to reach the
# backend, Postgres and Redis. The default is what compose derives from
# /opt/open-gerege-nexus; `docker network ls` says what yours is called.
NEXUS_NETWORK=fuelnet-gerege-nexus_default

# Where Grafana is published on loopback. 3009 is the default and is not free
# on every host — a machine running sibling products may already have it. Check
# with `docker ps --format "{{.Ports}}" | grep 3009` before the first rollout;
# nexus.gerege.mn uses 3030 because gerege_salus_frontend holds 3009.
GRAFANA_PORT=3009

# The zone alert timestamps are rendered in. Alertmanager formats them with the
# container's clock, and UTC in a message read on a local phone is arithmetic
# nobody wants to do at three in the morning.
ALERT_TIMEZONE=Asia/Ulaanbaatar

# ------------------------------------------------------- tracing (optional)

# Traces are off in the platform until the backend is given this. Point it at
# Tempo, which this stack runs and publishes on the platform network:
#
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://gerege_nexus_tempo:4318
#
# That variable goes in the PLATFORM's .env, not this file — it is the backend
# that reads it. It is noted here because Tempo is what it points at.
#
# Sampling: OTEL_TRACES_SAMPLER_ARG, a ratio between 0 and 1, default 0.1.

# ------------------------------------------- error tracking (optional, separate)

# Used only by deploy/docker-compose.glitchtip.yml. Generate the key with:
#   openssl rand -base64 48
GLITCHTIP_DB_PASSWORD=
GLITCHTIP_SECRET_KEY=
GLITCHTIP_DOMAIN=https://nexus.gerege.mn/glitchtip
# consolemail:// writes invitations to the container log instead of sending
# them. A real one looks like smtp://user:pass@host:587
GLITCHTIP_EMAIL_URL=consolemail://

# ------------------------------------------------ alert delivery (both optional)

# E-mail. Leave ALERT_EMAIL_TO or ALERT_SMTP_HOST empty and the e-mail channel
# is simply not rendered — alerts still fire and are still visible in
# Alertmanager and Grafana, they are just not delivered anywhere.
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=nexus-alerts@gerege.mn
ALERT_SMTP_HOST=
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_SMTP_REQUIRE_TLS=true

# Telegram, for `severity: page` only. Create a bot with @BotFather, add it to
# the group, and read the chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates — a group id is negative.
# Both must be set or the channel is not rendered.
ALERT_TELEGRAM_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
