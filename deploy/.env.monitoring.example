# Environment for deploy/docker-compose.monitoring.yml.
#
# Copy to /opt/open-gerege-nexus/.env.monitoring on the server and fill in the
# two required values. Never commit the real file — it carries the Grafana
# administrator password, the monitoring database password and, if e-mail is
# configured, an SMTP credential.
#
#   docker compose -f deploy/docker-compose.monitoring.yml \
#     --env-file .env.monitoring up -d
#
# The platform stack has its own .env and is unaffected by anything here.

# ---------------------------------------------------------------- required

# Grafana's administrator. There is no default on purpose: a Grafana on
# admin/admin behind a public nginx is somebody else's infrastructure on
# display. Generate with: openssl rand -base64 24
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# The password for the `monitoring` database role. Migration 00044 creates the
# role with pg_monitor and no password; set the same value here and on the role
# itself, once:
#
#   docker exec -i gerege_nexus_postgres psql -U postgres -d platform_db \
#     -c "ALTER ROLE monitoring WITH PASSWORD 'the value below'"
#
# The role can read pg_stat_* and nothing else — no table, no tenant row.
MONITORING_DB_PASSWORD=

# ---------------------------------------------------------------- optional

# Named on every alert, so a message at 03:00 says which deployment before
# anything has to be opened. Set it when more than one instance reports to the
# same inbox.
DEPLOYMENT_NAME=nexus

# Where Grafana and Alertmanager are reached from a browser. Grafana builds
# every link it emits from this, so a wrong value gives working pages with
# broken links.
MONITORING_PUBLIC_URL=https://nexus.gerege.mn

# The platform stack's Docker network, which this stack joins to reach the
# backend, Postgres and Redis. The default is what compose derives from
# /opt/open-gerege-nexus; `docker network ls` says what yours is called.
NEXUS_NETWORK=open-gerege-nexus_default

# ------------------------------------------------ alert delivery (both optional)

# E-mail. Leave ALERT_EMAIL_TO or ALERT_SMTP_HOST empty and the e-mail channel
# is simply not rendered — alerts still fire and are still visible in
# Alertmanager and Grafana, they are just not delivered anywhere.
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=nexus-alerts@gerege.mn
ALERT_SMTP_HOST=
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_SMTP_REQUIRE_TLS=true

# Telegram, for `severity: page` only. Create a bot with @BotFather, add it to
# the group, and read the chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates — a group id is negative.
# Both must be set or the channel is not rendered.
ALERT_TELEGRAM_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
